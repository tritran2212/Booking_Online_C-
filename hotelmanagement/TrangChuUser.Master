<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="TrangChuUser.master.cs" Inherits="hotelmanagement.TrangChuUser" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .container {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 40px;
            height: 100px;
            width: 100%;
            background: linear-gradient(to right, #36D1DC, #5B86E5);
        }

        .header h1 {
            margin: 0;
        }

        .header img {
            height: 40px;
        }

        .btn-header {
            color: #fff;
            font-size: 16px;
            text-decoration: none;
            margin-left: 20px;
            transition: color 0.3s, text-decoration 0.3s;
        }

        .btn-header:hover {
            text-decoration: underline;
            color: #e0e0e0;
        }

        .header-links {
            display: flex;
            align-items: center;
        }

        .account-wrapper {
            position: relative;
            margin-left: 30px;
        }

        .account-icon {
            font-size: 26px;
            color: white;
            cursor: pointer;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            top: 40px;
            background-color: white;
            min-width: 180px;
            border: 1px solid #ccc;
            border-radius: 6px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            z-index: 1000;
        }

        .dropdown-content a,
        .dropdown-content asp\:linkbutton {
            display: block;
            padding: 10px;
            color: #333;
            text-decoration: none;
            font-size: 14px;
        }

        .dropdown-content a:hover,
        .dropdown-content asp\:linkbutton:hover {
            background-color: #f0f0f0;
        }

        .cont {
            flex: 1;
            padding: 0;
        }

        .hero {
            overflow-x: auto;
            overflow-y: hidden;
            white-space: nowrap;
            -webkit-overflow-scrolling: touch;
        }

        .hero-slider {
            display: inline-flex;
        }

        .hero-slider img {
            width: 80%;
            max-width: 100%;
            height: auto;
            flex-shrink: 0;
            object-fit: cover;
            margin-right: 10px;
            border-radius: 8px;
            max-height: 500px;
        }

        .hero::-webkit-scrollbar {
            display: none;
        }

        .footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 16px;
            padding: 20px 40px;
            border-top: 1px solid #ddd;
            background: #f8f8f8;
        }

        .footer-left a,
        .footer-right a {
            margin-left: 15px;
            color: #333;
            text-decoration: none;
        }

        .footer-left a:first-child {
            margin-left: 0;
        }

        .footer-right a {
            display: inline-flex;
            align-items: center;
        }

        .footer a:hover {
            text-decoration: underline;
        }
    </style>

    <script type="text/javascript">
        function toggleDropdown() {
            var dropdown = document.getElementById("userDropdown");
            if (dropdown.style.display === "block") {
                dropdown.style.display = "none";
            } else {
                dropdown.style.display = "block";
            }
        }

        window.onclick = function (event) {
            if (!event.target.matches('.account-icon')) {
                var dropdown = document.getElementById("userDropdown");
                if (dropdown && dropdown.style.display === "block") {
                    dropdown.style.display = "none";
                }
            }
        }
    </script>
</head>
<body>
    <form id="form1" runat="server">
        <div class="container">
            <!-- Header -->
            <div class="header">
                <h1>
                    <a href="#" aria-label="Trang chủ Airbnb">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/6/69/Airbnb_Logo_Bélo.svg/2560px-Airbnb_Logo_Bélo.svg.png" alt="Airbnb">
                    </a>
                </h1>

                <div class="header-links">
                    <asp:LinkButton ID="btnTrangChu" CssClass="btn-header" runat="server" OnClick="btnTrangChu_Click">Trang Chủ</asp:LinkButton>
                    <asp:LinkButton ID="btnChiTietPhong" CssClass="btn-header" runat="server">Chi Tiết Phòng</asp:LinkButton>
                    <asp:LinkButton ID="btnLienHe" CssClass="btn-header" runat="server" OnClick="btnLienHe_Click">Liên Hệ</asp:LinkButton>

                    <!-- User icon dropdown -->
                    <div class="account-wrapper">
                        <i class="fas fa-user-circle account-icon" onclick="toggleDropdown()"></i>
                        <div id="userDropdown" class="dropdown-content">
                            <asp:LinkButton ID="lnkTrangThaiDatPhong" runat="server" PostBackUrl="~/TrangThaiDatPhong.aspx">Trạng thái đặt phòng</asp:LinkButton>
                            <asp:LinkButton ID="lnkDangXuat" runat="server" >Đăng xuất</asp:LinkButton>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main content -->
            <div class="cont">
                <asp:ContentPlaceHolder ID="HeroContent" runat="server"></asp:ContentPlaceHolder>
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
            </div>

            <!-- Footer -->
            <div class="footer">
                <div class="footer-left">
                    <span>© 2025 Airbnb, Inc.</span>
                    <a href="#">Quyền riêng tư</a>
                    <a href="#">Điều khoản</a>
                    <a href="#">Sơ đồ trang web</a>
                </div>
                <div class="footer-right">
                    <a href="#"><span> Tiếng Việt (VN)</span></a>
                    <a href="#"><span> VND</span></a>
                    <a href="#"><i class="fab fa-facebook-f"></i></a>
                    <a href="#"><i class="fab fa-x-twitter"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                </div>
            </div>
        </div>
    </form>
</body>
</html>